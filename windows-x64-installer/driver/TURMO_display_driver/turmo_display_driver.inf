;
; turmo_display_driver.inf
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGuid = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=turmo_display_driver.cat
DriverVer = 03/20/2026,11.47.25.424

[Manufacturer]
%ManufacturerName%=Standard, NTamd64.10.0...17763, NTamd64.10.0...22000

[Standard.NTamd64.10.0...17763]
%DeviceName%=turmo_Display_Install_Win10, USB\VID_A188&PID_AD88&MI_00

[Standard.NTamd64.10.0...22000]
%DeviceName%=turmo_Display_Install_Win11, USB\VID_A188&PID_AD88&MI_00

[SourceDisksFiles]
turmo_display_driver.dll=1
UsbDispCfg.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[turmo_Display_Install_Win10.NT]
CopyFiles=UMDriverCopy,PropPageCopy
AddReg = PropPageSettings

[turmo_Display_Install_Win11.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy,PropPageCopy
AddReg = PropPageSettings

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf
PropPageCopy=11

[UMDriverCopy]
turmo_display_driver.dll

[PropPageCopy]
UsbDispCfg.dll

[turmo_Display_Install_Win10.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[turmo_Display_Install_Win11.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "IddTURMODriverGroup"
HKR,,Security,,"D:P(A;;GA;;;WD)"

[PropPageSettings]
HKR,,EnumPropPages32, 0, "UsbDispCfg.dll,UsbDispCfgPropPageProvider"

[turmo_Display_Install_Win10.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[turmo_Display_Install_Win11.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[turmo_Display_Install_Win10.NT.Wdf]
UmdfDispatcher=NativeUSB
UmdfService=turmo_display_driver,turmo_display_driver_Install
UmdfServiceOrder=turmo_display_driver
UmdfKernelModeClientPolicy = AllowKernelModeClients

[turmo_Display_Install_Win11.NT.Wdf]
UmdfDispatcher=NativeUSB
UmdfService=turmo_display_driver,turmo_display_driver_Install
UmdfServiceOrder=turmo_display_driver
UmdfKernelModeClientPolicy = AllowKernelModeClients

[turmo_display_driver_Install]
UmdfLibraryVersion=2.15.0
ServiceBinary=%12%\UMDF\turmo_display_driver.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

; =================== Generic ==================================

[Strings]
ManufacturerName="TURMO Display" ; TODO: Replace with your manufacturer name
DiskName = "idd display" ; TODO: Replace with driver disk name
WudfRdDisplayName="TURMO Display Driver"
DeviceName="TURMO Display" ; TODO: Replace with correct device name

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
